# Copy to .env. Supply real secrets only in that ignored file.
DATABASE_URL="postgresql://scopefree:CHANGE_ME@127.0.0.1:5432/scopefree"
APP_ORIGIN="http://127.0.0.1:3000"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Scope analysis and the future chatbot share this server-only configuration.
AI_PROVIDER="featherless"
AI_BASE_URL="https://api.featherless.ai/v1"
AI_MODEL=""
AI_API_KEY=""
# Leave false unless this endpoint/model's native schema support is verified.
AI_NATIVE_JSON_SCHEMA="false"
# Conservative scope-analysis budget; verify the endpoint/model supports any increase.
AI_CONTEXT_TOKENS="32768"
AI_MAX_OUTPUT_TOKENS="6000"
# Optional Featherless/model template control. Use default for endpoints without this extension.
AI_THINKING="default"
AI_REASONING_EFFORT="default"
# Low-variance scope classification; use default to omit for incompatible endpoints/models.
AI_TEMPERATURE="0"
# Per-call deadline (1000-90000 ms); the complete analysis/repair has a 120-second cap.
AI_REQUEST_TIMEOUT_MS="30000"
# Private client links; whole days, 1-90.
PROPOSAL_LINK_DAYS="7"
CLIENT_INTAKE_LINK_DAYS="30"

# Transactional email for proposal delivery. The freelancer no longer copies the proposal link by
# hand; ScopeFree emails the secure link to the client's address. Provider-neutral: EMAIL_API_URL is
# a transactional HTTP JSON endpoint (Resend/Postmark-shaped) that accepts { from, to, subject, html,
# text } with a bearer key. EMAIL_FROM must be a sender your provider has verified. Missing values
# return an honest EMAIL_NOT_CONFIGURED error; never commit real credentials.
EMAIL_PROVIDER="http-json"
EMAIL_API_URL="https://api.resend.com/emails"
EMAIL_API_KEY=""
EMAIL_FROM=""
# Per-send deadline (1000-90000 ms).
EMAIL_REQUEST_TIMEOUT_MS="15000"
