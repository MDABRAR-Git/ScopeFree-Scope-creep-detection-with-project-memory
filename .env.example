# Copy to .env. Supply real secrets only in that ignored file.
DATABASE_URL="postgresql://scopefree:CHANGE_ME@127.0.0.1:5432/scopefree"
APP_ORIGIN="http://127.0.0.1:3000"
# Run npm run password:hash and paste its base64-encoded Argon2id hash below.
FREELANCER_PASSWORD_HASH=""
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Scope analysis and the future chatbot share this server-only configuration.
AI_PROVIDER="featherless"
AI_BASE_URL="https://api.featherless.ai/v1"
AI_MODEL=""
AI_API_KEY=""
# Leave false unless this endpoint/model's native schema support is verified.
AI_NATIVE_JSON_SCHEMA="false"
# Conservative scope-analysis budget; verify the endpoint/model supports any increase.
AI_CONTEXT_TOKENS="32768"
AI_MAX_OUTPUT_TOKENS="6000"
# Optional Featherless/model template control. Use default for endpoints without this extension.
AI_THINKING="default"
AI_REASONING_EFFORT="default"
# Per-call deadline (1000-90000 ms); the complete analysis/repair has a 120-second cap.
AI_REQUEST_TIMEOUT_MS="30000"
