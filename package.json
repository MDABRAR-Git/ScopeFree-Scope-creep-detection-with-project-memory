{
  "name": "scopefree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "node scripts/migrate-test-db.mjs",
    "test:e2e": "playwright test",
    "test:runtime": "node scripts/verify-runtime.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "password:hash": "node scripts/hash-password.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "^17.2.3",
    "iron-session": "9.0.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "prisma": { "mysql2": "3.24.3" }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
